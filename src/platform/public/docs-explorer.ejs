            const subscribeEvents = [];
            
            Object.keys(channels).forEach(channel => {
                const channelData = channels[channel];
                if (channelData.publish) {
                    const ev = { channel, type: 'publish', ...channelData.publish };
                    if (!searchQuery || 
                        channel.toLowerCase().includes(searchQuery) ||
                        ev.summary?.toLowerCase().includes(searchQuery) ||
                        ev.description?.toLowerCase().includes(searchQuery)) {
                        publishEvents.push(ev);
                        hasResults = true;
                        totalItems++;
                    }
                }
                if (channelData.subscribe) {
                    const ev = { channel, type: 'subscribe', ...channelData.subscribe };
                    if (!searchQuery || 
                        channel.toLowerCase().includes(searchQuery) ||
                        ev.summary?.toLowerCase().includes(searchQuery) ||
                        ev.description?.toLowerCase().includes(searchQuery)) {
                        subscribeEvents.push(ev);
                        hasResults = true;
                        totalItems++;
                    }
                }
