            let html = '';
            
            if (publishEvents.length > 0) {
                html += `
                    <div class="mb-6 sm:mb-8">
                        <h3 class="text-base sm:text-lg font-semibold mb-3 sm:mb-4 flex flex-wrap items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-blue-500 flex-shrink-0"></span>
                            <span>Client → Server</span>
                            <span class="text-xs sm:text-sm text-gray-500 font-normal w-full sm:w-auto">Eventos enviados pelo cliente</span>
