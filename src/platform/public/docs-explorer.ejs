            return `
                <div id="${endpoint.id}" class="glass-effect rounded-lg sm:rounded-xl border border-gray-700 endpoint-card transition-colors">
                    <div class="p-3 sm:p-4 cursor-pointer" onclick="toggleEndpoint('${endpoint.id}')">
