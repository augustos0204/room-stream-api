                                    <div class="code-block-header">
                                        <div class="code-block-label">
                                            <i data-lucide="upload" class="w-3.5 h-3.5 text-blue-400"></i>
                                            <span>Request Body</span>
                                            <span class="text-blue-400/60 text-xs font-normal normal-case">application/json</span>
                                        </div>
                                        <button onclick="copySchema('${endpoint.id}-request')" class="copy-btn p-1.5 rounded-md transition-colors hover:bg-white/10" title="Copy to clipboard">
                                            <i data-lucide="copy" class="w-3.5 h-3.5 text-gray-400"></i>
                                        </button>
                                    </div>
                                    <div class="code-block-content scrollbar-thin">
