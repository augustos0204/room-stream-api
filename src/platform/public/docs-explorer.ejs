                            </div>
                            <i data-lucide="chevron-down" class="w-4 h-4 sm:w-5 sm:h-5 text-gray-500 transition-transform flex-shrink-0" id="icon-${endpoint.id}"></i>
                        </div>
                        <p class="text-xs sm:text-sm text-gray-400 mt-2">${highlightSearch(endpoint.summary || '')}</p>
                    </div>
                    
                    <div id="details-${endpoint.id}" class="hidden border-t border-gray-700">
