                            ${endpoint.parameters?.length ? `
                                <div>
                                    <h4 class="text-xs sm:text-sm font-semibold mb-2 flex items-center gap-2">
                                        <i data-lucide="settings-2" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-purple-400"></i>
                                        Parâmetros
                                    </h4>
                                    <div class="bg-gray-900/50 rounded-lg p-2 sm:p-3 space-y-2 overflow-x-auto">
                                        ${endpoint.parameters.map(p => `
                                            <div class="flex flex-wrap items-start gap-1 sm:gap-2 text-xs sm:text-sm">
                                                <span class="font-mono text-purple-400">${p.name}</span>
                                                <span class="text-gray-500">(${p.in})</span>
                                                ${p.required ? '<span class="text-red-400 text-xs">required</span>' : ''}
