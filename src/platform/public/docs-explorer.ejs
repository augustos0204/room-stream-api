                                        </div>
                                        <button onclick="copySchema('${endpoint.id}-response')" class="copy-btn p-1.5 rounded-md transition-colors hover:bg-white/10" title="Copy to clipboard">
                                            <i data-lucide="copy" class="w-3.5 h-3.5 text-gray-400"></i>
