<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <% const isDev = process.env.NODE_ENV !== 'production'; %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="<%= isDev ? '#ea580c' : '#1e1b4b' %>">
    <meta name="color-scheme" content="dark">
    <title><%= appName || 'RoomStream' %><%= isDev ? ' (DEV)' : '' %> - Sobre</title>
    <link rel="icon" type="image/svg+xml" href="/platform/assets/media/<%= isDev ? 'favicon-dev.svg' : 'favicon.svg' %>">

    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    animation: {
                        'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="/platform/assets/styles/main.css">

    <style>
        [x-cloak] { display: none !important; }
    </style>
</head>
<body class="bg-slate-950 bg-gradient-to-br from-slate-950 via-purple-950 to-indigo-950 text-white font-mono min-h-[100dvh]">

    <!-- Background animated elements -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-purple-500 rounded-full mix-blend-multiply filter blur-3xl opacity-10 animate-pulse-slow"></div>
        <div class="absolute top-1/3 right-1/4 w-96 h-96 bg-blue-500 rounded-full mix-blend-multiply filter blur-3xl opacity-10 animate-pulse-slow" style="animation-delay: 1s;"></div>
        <div class="absolute bottom-1/4 left-1/3 w-96 h-96 bg-indigo-500 rounded-full mix-blend-multiply filter blur-3xl opacity-10 animate-pulse-slow" style="animation-delay: 2s;"></div>
    </div>

    <nav class="relative z-10 dark-glass border-b border-gray-700/50">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center gap-3">
                    <%- include('../components/ui/logo', { size: 'sm', withBackground: false, withShadow: false }) %>
                    <span class="text-lg font-semibold text-white"><%= appName || 'RoomStream' %></span>
                </div>
                <div class="flex items-center gap-4 text-sm">
                    <a href="/" class="text-gray-300 hover:text-white transition-colors">Inicio</a>
                    <a href="/docs/api" class="text-gray-300 hover:text-white transition-colors">Docs</a>
                    <a href="/platform" class="px-4 py-2 bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-700 hover:to-blue-700 rounded-lg text-white font-medium transition-all">Dashboard</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="relative z-10 px-4 sm:px-6 lg:px-8 py-10">
        <%- include('../components/pages/about') %>
    </main>

    <footer class="relative z-10 border-t border-gray-700/50 py-6 px-4 sm:px-6 lg:px-8 text-sm text-gray-400">
        <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-4">
            <span><%= appName || 'RoomStream' %> • <%= new Date().getFullYear() %></span>
            <div class="flex items-center gap-4">
                <a href="/platform" class="hover:text-white transition-colors">Dashboard</a>
                <a href="/docs/api" class="hover:text-white transition-colors">Documentacao</a>
            </div>
        </div>
    </footer>

    <script>
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }
    </script>
</body>
</html>
