<!-- Room Applications Modal (Bottom Sheet on Mobile, Modal on Desktop) -->
<div
    x-show="showRoomApplicationsModal"
    class="fixed inset-0 z-50 md:flex md:items-center md:justify-center md:p-4"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
>
    <!-- Backdrop -->
    <div class="fixed inset-0 bg-black/70 backdrop-blur-sm" @click="closeRoomApplicationsModal()"></div>

    <!-- Bottom Sheet (Mobile) / Modal (Desktop) -->
    <div
        x-ref="roomApplicationsSheet"
        class="
            fixed inset-x-0 bottom-0
            max-h-[85vh] rounded-t-3xl
            md:relative md:inset-auto md:max-w-lg md:w-full md:rounded-xl
            dark-glass border-t md:border border-gray-700/50
            overflow-y-auto
        "
        data-fullheight-sheet="false"
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="translate-y-full md:opacity-0 md:scale-95 md:translate-y-0"
        x-transition:enter-end="translate-y-0 md:opacity-100 md:scale-100"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="translate-y-0 md:opacity-100 md:scale-100"
        x-transition:leave-end="translate-y-full md:opacity-0 md:scale-95 md:translate-y-0"
        @click.stop
    >
        <!-- Drag Handle (Mobile Only) -->
        <div 
            class="md:hidden flex justify-center py-3 cursor-grab active:cursor-grabbing"
            @touchstart="handleSheetTouchStart($event)"
            @touchmove="handleSheetTouchMove($event, $refs.roomApplicationsSheet)"
            @touchend="handleSheetTouchEnd($event, $refs.roomApplicationsSheet, 'showRoomApplicationsModal')"
        >
            <div class="w-12 h-1.5 rounded-full bg-gray-600 transition-colors hover:bg-gray-400"></div>
        </div>

        <!-- Header -->
        <div class="flex items-center justify-between p-6 border-b border-gray-700/50">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center">
                    <i data-lucide="link-2" class="w-5 h-5 text-white"></i>
                </div>
                <div>
                    <h2 class="text-xl font-bold text-white">Aplicacoes da Sala</h2>
                    <p class="text-sm text-gray-400" x-text="selectedRoomForApplications?.name"></p>
                </div>
            </div>
            <button
                @click="closeRoomApplicationsModal()"
                class="p-2 hover:bg-gray-700/50 rounded-lg transition-colors"
            >
                <i data-lucide="x" class="w-5 h-5 text-gray-400"></i>
            </button>
        </div>

        <!-- Content -->
        <div class="p-6 space-y-4">
            <template x-if="isLoadingRoomApplications">
                <div class="text-center py-8">
                    <i data-lucide="loader-2" class="w-10 h-10 text-amber-500 mx-auto mb-3 animate-spin"></i>
                    <p class="text-gray-400">Carregando aplicacoes...</p>
                </div>
            </template>

            <template x-if="!isLoadingRoomApplications && applications.length === 0">
                <div class="text-center py-6">
                    <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-800 flex items-center justify-center">
                        <i data-lucide="plug" class="w-8 h-8 text-gray-600"></i>
                    </div>
                    <h3 class="text-lg font-semibold text-white mb-2">Nenhuma aplicacao encontrada</h3>
                    <p class="text-gray-400">Crie uma aplicacao para vincular a esta sala.</p>
                </div>
            </template>

            <template x-if="!isLoadingRoomApplications && applications.length > 0">
                <div class="space-y-3">
                    <template x-for="app in applications" :key="app.id">
                        <div class="flex items-center justify-between gap-4 p-4 rounded-xl border border-gray-700/50 bg-gray-900/40">
                            <div class="min-w-0">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-white" x-text="app.name"></span>
                                    <span
                                        class="text-xs px-2 py-0.5 rounded-full"
                                        :class="app.isActive ? 'bg-green-500/20 text-green-400' : 'bg-red-500/20 text-red-400'"
                                        x-text="app.isActive ? 'Ativo' : 'Inativo'"
                                    ></span>
                                </div>
                                <p class="text-xs text-gray-500 font-mono" x-text="app.keyPreview"></p>
                                <div
                                    x-show="isApplicationLinked(app.id) && getApplicationLinkMeta(app.id)"
                                    class="mt-2 text-xs text-gray-400"
                                >
                                    <span>
                                        Vinculado em
                                        <span class="text-gray-300" x-text="new Date(getApplicationLinkMeta(app.id).linkedAt).toLocaleString('pt-BR')"></span>
                                    </span>
                                    <span
                                        x-show="getApplicationLinkMeta(app.id).linkedBy"
                                        class="block"
                                    >
                                        Por <span class="text-gray-300" x-text="getApplicationLinkMeta(app.id).linkedBy"></span>
                                    </span>
                                </div>
                            </div>

                            <button
                                @click="toggleRoomApplication(app)"
                                :disabled="savingRoomApplicationId === app.id"
                                class="px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 disabled:opacity-50"
                                :class="isApplicationLinked(app.id)
                                    ? 'bg-red-500/20 text-red-300 border border-red-500/30 hover:bg-red-500/30'
                                    : 'bg-amber-500/20 text-amber-200 border border-amber-500/30 hover:bg-amber-500/30'"
                            >
                                <span x-show="savingRoomApplicationId !== app.id" x-text="isApplicationLinked(app.id) ? 'Remover' : 'Vincular'"></span>
                                <span x-show="savingRoomApplicationId === app.id" class="flex items-center gap-2">
                                    <span class="w-4 h-4 border-2 border-current border-t-transparent rounded-full animate-spin"></span>
                                    Salvando
                                </span>
                            </button>
                        </div>
                    </template>
                </div>
            </template>
        </div>
    </div>
</div>
