# 🚀 SERVER CONFIGURATION
# Port where the application will run
PORT=3000

# Node environment (development, production)
NODE_ENV=development

# 🌐 CORS CONFIGURATION
CORS_ORIGIN=*

# 🔌 WEBSOCKET CONFIGURATION
WEBSOCKET_NAMESPACE=/ws/rooms

# 🔐 SECURITY CONFIGURATION
# If not set, API key authentication is disabled
API_KEY=your-secret-api-key-here

# 🔑 SUPABASE CONFIGURATION
# If not set, Supabase authentication is disabled
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Token validation interval for WebSocket connections (in milliseconds)
# Default: 300000 (5 minutes)
# This setting controls how often Supabase JWT tokens are revalidated for active WebSocket connections
TOKEN_VALIDATION_INTERVAL=300000

# 💾 REDIS CONFIGURATION
# If not set, falls back to in-memory storage
# Redis is used for room runtime data (participants, messages, presence)
# Example: redis://localhost:6379 or redis://username:password@host:port/db
REDIS_URL=redis://localhost:6379

# ⏱️ PRESENCE CONFIGURATION
# TTL for participant presence data in seconds (used by Redis adapter)
# Should be higher than Socket.IO ping interval + timeout
ROOM_PARTICIPANT_TTL_SECONDS=120

# 📦 APPLICATION INFO
# Application name (used in Docker deployments)
APP_NAME=RoomStream

# 🐙 GITHUB CONFIGURATION
# Enable/disable GitHub API response caching (default: true)
# Set to 'false' to disable caching during development
GITHUB_CACHE_ENABLED=true
